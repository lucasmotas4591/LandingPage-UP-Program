body{
        background-color:#FDF5E6;
        color: black;
        font-family: 'Lato', sans-serif;
        max-width: 1000px;
        margin: 0 auto;
        padding: 15px;
}

header{
    background-color: #FDF5E6;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

#title{
    flex-direction: column;
    line-height: 10px;
}
li{
    display: inline-block;
    margin: 25px;
}
a{
    color:darkred ;
}
a:hover{
    color: #FDF5E6;
    transition: 0.3s all;
    border: 5px solid darkred;
    padding: 10px;
    background-color:green ;
}
h1{
    font-weight: 200;
}
main{
    display: flex;
    flex-direction: row;
    margin-top: 70px;
}
h2{
    font-size: 30px;
}
span:first-child{
    
  color: green;
  font-weight: bold;
  font-size: 32px;
}
span:nth-child(2){
    color:darkred;
     font-weight: bold;
    font-size: 32px;
}
p{
    line-height: 20px;
    font-family: Arial, Helvetica, sans-serif;
}
img{
    width: 740px;
}
form{
    display: flex;
    flex-direction: column;
    width: 70%
}
#enviarbtn{
    height: 50px;
    width: 50%;
    background-color: green;
    color: #FDF5E6;
    font-weight: bold;
    border: 5px solid darkred;
    
}
#enviarbtn:hover{
    cursor: pointer;
}
input{
    margin-top: 20px;
    height: 20px;
    padding: 15px;
}

footer {
    background-color: #FDF5E6; 
    padding: 40px 20px; 
    max-width: 1100px;         
    margin: 0 auto;            
    text-align: left;       
}
